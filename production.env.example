# Copy to an absolute path outside this repository, restrict file permissions,
# and set TODAYPHARM_ENV_FILE to that path when running compose.production.yml.
# Supply the short-lived database-scoped read-only token as TURSO_AUTH_TOKEN
# in the invoking process environment. It is used only by BuildKit; do not
# place the build token in a file or in this runtime environment template.
# Set TODAYPHARM_BUILD_TURSO_DATABASE_URL to the database URL for that token.
# Public IDs default to the current live values: TODAYPHARM_GA_ID and
# TODAYPHARM_ADSENSE_PUB_ID may be overridden when explicitly reconciled.
# Public build flags TODAYPHARM_ADSENSE_SERVING_ENABLED and
# TODAYPHARM_AFFILIATE_ADS_ENABLED default to false unless explicitly set.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_PASSWORD=
JWT_SECRET=
REVALIDATION_SECRET=

# Optional: index only pharmacies with an intelligence report (AdSense review period). Check enrich:pharmacies:stats first.
# PHARMACY_INDEX_REQUIRES_ENRICHMENT=false
